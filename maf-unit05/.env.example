# One shared configuration file. Nonempty process values override file values.
# demo is an explicitly labelled deterministic client inside the real MAF pipeline.
MAF_EXECUTION_MODE=demo
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
TENANT_ID=
SUBSCRIPTION_ID=
PROMPT_VERSION=v2
REQUEST_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=1600
MAX_ITERATIONS=4
# The business adapter retains the topic's fixed three-attempt budget per run.
# Sampling temperature and TopP are deliberately left unset.
