# Shared settings for every example and exercise. Existing process values win.
# Edit this root file once. Keep deployment names distinct from model families.
MAF_MODEL_PROVIDER=foundry-local
CHAT_FAST_DEPLOYMENT=chat-fast
CHAT_QUALITY_DEPLOYMENT=chat-quality
TENANT_ID = "7d384181-9169-4237-9c90-1cb3bfb04d94"
SUBSCRIPTION_ID = "2bcbc61d-2a42-4622-800c-5fd9b3a2e909"
AZURE_OPENAI_ENDPOINT="https://azoai-maf-nov2026.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT_NAME="chat-fast"

# Foundry Models: copy a supported OpenAI v1 URL from the deployment.
FOUNDRY_MODELS_BASE_URL= "https://azoai-maf-nov2026.openai.azure.com/openai/v1/"
FOUNDRY_MODEL_A=chat-fast
FOUNDRY_MODEL_B=chat-quality
FOUNDRY_AUTH_MODE=entra
FOUNDRY_MODELS_API_KEY=

# Use the full local model ID shown by Foundry Local, including its device variant.
FOUNDRY_LOCAL_BASE_URL=http://127.0.0.1:39839/v1/
FOUNDRY_LOCAL_MODEL=deepseek-r1-distill-qwen-1.5b-generic-gpu:4
FOUNDRY_LOCAL_API_MODEL=deepseek-r1-distill-qwen-1.5b-generic-gpu:4

REQUEST_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=512
OBSERVABILITY_RUNS=3
APPLICATION_COMMIT=unrecorded
INSTRUCTIONS_VERSION=unit02-v1

# Fill from the actual Azure deployment configuration before approving an upgrade.
BASELINE_MODEL_FAMILY=
BASELINE_MODEL_VERSION=
BASELINE_UPGRADE_POLICY=
CANDIDATE_MODEL_FAMILY=
CANDIDATE_MODEL_VERSION=
CANDIDATE_UPGRADE_POLICY=

# Optional inference ID returned by GET /v1/models.
FOUNDRY_LOCAL_API_MODEL=
