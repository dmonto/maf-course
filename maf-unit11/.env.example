UNIT11_DB=
# Optional assigned non-session Service Bus queue; not needed for local examples.
SERVICEBUS_NAMESPACE=YOUR-NAMESPACE.servicebus.windows.net
SERVICEBUS_QUEUE=YOUR-TRAINING-QUEUE
