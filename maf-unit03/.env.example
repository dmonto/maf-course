# One configuration file shared by every project. Existing nonempty process values win.
# Demo mode uses a labelled synthetic client inside the real MAF pipeline.
MAF_EXECUTION_MODE=demo
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
TENANT_ID=
SUBSCRIPTION_ID=

# Defaults match the Unit 3 service-status application.
REQUEST_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=800
MAX_ITERATIONS=4
MAX_TOOL_ATTEMPTS=3
MAX_CONVERSATION_TURNS=8
