# One .env for the entire pack. Nonempty process environment values take precedence.
# demo uses a clearly labelled scripted client inside the real MAF pipeline.
MAF_EXECUTION_MODE=demo
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
TENANT_ID=
SUBSCRIPTION_ID=

COURSE_PORT=5050
Agent__PromptVersion=v1
REQUEST_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=800
MAX_ITERATIONS=4
MAX_CONVERSATION_TURNS=6
MAX_RETAINED_CONVERSATIONS=20

# Read only by the Exercise 2 solution; ordinary examples do not implement expiry.
CONVERSATION_IDLE_SECONDS=60
