# One shared configuration file for every project in this package.
# The first execution creates .env from this template if it does not exist.
# Nonempty process environment variables take precedence over file values.
MAF_EXECUTION_MODE=demo
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
TENANT_ID=
SUBSCRIPTION_ID=
REQUEST_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=800
MAX_ITERATIONS=3
# Relative database paths are resolved against this package root.
MAF_MEMORY_DATABASE=data/memory.db
# Used only by the separate Exercise 2 solution. The baseline uses 24 hours.
MAF_MEMORY_IDLE_SECONDS=86400
